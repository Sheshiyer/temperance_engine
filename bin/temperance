#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if test "${1:-}" = "cutover-plan"; then
  shift
  exec bun run "$ROOT_DIR/scripts/v4-cutover-plan.ts" "$@"
fi

for argument in "$@"; do
  case "$argument" in
    --record|--repair-duplicates)
      printf '%s\n' "temperance doctor is permanently read-only; repair and recording move to separately governed Phase 3 lifecycle commands" >&2
      exit 2
      ;;
  esac
done

exec bun run "$ROOT_DIR/package/install-surface/src/cli.ts" "$@"
