{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoughtseed.space/schemas/temperance/doctor-report/v1",
  "title": "Temperance read-only doctor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "generated_at", "scope", "requested_sections", "overall_condition", "exit_code", "manifest_digest", "sections"],
  "properties": {
    "schema": { "const": "temperance.doctor.report.v1" },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": { "major": { "const": 1 }, "minor": { "const": 0 } }
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["complete", "partial"] },
    "requested_sections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["install", "privacy", "runtime"] } },
    "overall_condition": { "$ref": "#/$defs/condition" },
    "exit_code": { "enum": [0, 1, 2] },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "condition", "checks"],
        "properties": {
          "id": { "enum": ["install", "privacy", "runtime"] },
          "condition": { "$ref": "#/$defs/condition" },
          "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
        }
      }
    }
  },
  "$defs": {
    "condition": { "enum": ["PASS", "DRIFT", "WARN", "FAIL", "SKIPPED", "UNSUPPORTED", "PRIVATE", "UNAVAILABLE"] },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "destination", "class", "expected_state", "actual_state", "condition", "reason_code", "severity", "actionable", "remediation", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 192 },
        "source": { "type": "string", "maxLength": 1024 },
        "destination": { "type": "string", "maxLength": 1024 },
        "class": { "enum": ["COPY", "TRANSFORM", "REGENERATE", "NEVER-SHIP", "RUNTIME"] },
        "expected_state": { "type": "string", "maxLength": 2048 },
        "actual_state": { "type": "string", "maxLength": 2048 },
        "condition": { "$ref": "#/$defs/condition" },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 192 },
        "severity": { "enum": ["info", "warning", "error"] },
        "actionable": { "type": "boolean" },
        "remediation": { "type": "string", "maxLength": 2048 },
        "evidence": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 2048 } }
      }
    }
  }
}
