{
  "schema": "temperance.install-surface.fragment.v1",
  "schema_uri": "https://thoughtseed.space/schemas/temperance/install-surface/fragment/v1",
  "version": { "major": 1, "minor": 0 },
  "records": [
    {
      "id": "router.governed-runtime",
      "owner": "temperance-engine",
      "class": "COPY",
      "source": "package/router",
      "destination": { "root_token": "TEMPERANCE_STATE", "relative_path": "router", "ownership": { "kind": "exclusive-path" } },
      "authority": { "requirement_ids": ["PROV-02", "PROV-04", "PROV-07"], "isa": "ISC-769" },
      "eligibility": { "platforms": ["darwin", "linux"], "profiles": ["default"], "required": true },
      "verification": { "method": "sha256" },
      "rollback": { "policy": "restore-backup" }
    },
    {
      "id": "configuration.codex-managed-block",
      "owner": "temperance-engine",
      "class": "TRANSFORM",
      "source": "templates/codex.AGENTS.md",
      "destination": { "root_token": "CODEX_HOME", "relative_path": "AGENTS.md", "ownership": { "kind": "managed-block", "marker_id": "temperance-engine" } },
      "authority": { "requirement_ids": ["PROV-02", "PROV-04", "PROV-05", "PROV-07"], "isa": "ISC-770" },
      "eligibility": { "platforms": ["darwin", "linux"], "profiles": ["default"], "required": true },
      "verification": { "method": "adapter", "adapter_id": "managed-template-v1" },
      "rollback": { "policy": "restore-backup" }
    }
  ]
}
