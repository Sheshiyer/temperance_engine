    "forensics": { "mode": "ALGORITHM", "combo": "te-reason", "view": "EVIDENCE", "alchemy": "THINK", "group": "ops" },
    "diagnose-issues": { "mode": "ALGORITHM", "combo": "te-reason", "view": "EVIDENCE", "alchemy": "THINK", "group": "ops" },
