{
  "schema": "temperance.gsd-rail-map.v1",
  "gsd_home": "~/.claude/get-shit-done",
  "gsd_version": "1.30.0",
  "workflow_dir": "workflows",
  "notes": "GSD remains planning/execute authority. This map only names PAI mode, OmniRoute combo, Manifest view, and alchemy. Wrappers must read the upstream workflow file — do not fork GSD.",
  "defaults": {
    "mode": "ALGORITHM",
    "combo": "te-reason",
    "view": "PLANNING",
    "alchemy": "OBSERVE"
  },
  "groups": {
    "init": ["new-project", "map-codebase", "new-milestone", "new-workspace", "discovery-phase", "plant-seed", "profile-user"],
    "plan": ["discuss-phase", "discuss-phase-assumptions", "research-phase", "list-phase-assumptions", "plan-phase", "add-phase", "insert-phase", "remove-phase", "plan-milestone-gaps", "ui-phase"],
    "execute": ["execute-phase", "execute-plan", "quick", "fast", "do", "autonomous"],
    "verify": ["verify-phase", "validate-phase", "verify-work", "review", "ui-review", "audit-milestone", "audit-uat", "add-tests"],
    "ops": ["help", "progress", "next", "stats", "health", "doctor", "goal", "pause-work", "resume-project", "ship", "settings", "update", "note", "session-report", "cleanup", "check-todos", "add-todo", "transition", "complete-milestone", "milestone-summary", "forensics", "diagnose-issues", "manager", "list-workspaces", "remove-workspace", "pr-branch", "node-repair", "workstreams"]
  },
